# Timezone
TZ=Asia/Tokyo

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Pi-hole
PIHOLE_WEBPASSWORD=your_pihole_password_here

# WireGuard
WIREGUARD_SERVERURL=your.domain.com
WIREGUARD_PORT=51820
WIREGUARD_PEERS=3
WIREGUARD_PEERDNS=auto
WIREGUARD_SUBNET=10.13.13.0

# Linux user IDs (run: id $USER)
PUID=1000
PGID=1000
