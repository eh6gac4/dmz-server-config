# Timezone
TZ=Asia/Tokyo

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_ID=your_tunnel_id_here   # cloudflared tunnel list で確認
CLOUDFLARE_DOMAIN=example.com              # Cloudflare で管理しているドメイン

# Pi-hole
PIHOLE_WEBPASSWORD=your_pihole_password_here

# WireGuard
WIREGUARD_SERVERURL=your.domain.com
WIREGUARD_PORT=51820
WIREGUARD_PEERS=3
WIREGUARD_PEERDNS=auto
WIREGUARD_SUBNET=10.13.13.0

# Linux user IDs (run: id $USER)
PUID=1000
PGID=1000
